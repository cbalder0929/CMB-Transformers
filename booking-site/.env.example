# Copy this file to .env.local and fill it in. SETUP.md walks through where
# each value comes from. Never commit .env.local — it's already gitignored.

# --- Supabase (required — nothing works without this) ------------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar (optional — bookings save without it) -------------------
# Google Cloud Console -> APIs & Services -> Credentials
# Get the refresh token by running: npm run google-token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=carlosbalderas135@gmail.com

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BUSINESS_TIMEZONE=America/Chicago
TRAINER_PHONE=

# Set to true in Vercel only when you're ready for Google to index the site.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Coming in later layers --------------------------------------------------
# RESEND_API_KEY=
# FROM_EMAIL=
