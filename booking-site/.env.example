# Copy this file to .env.local and fill it in. SETUP.md walks through where
# each value comes from. Never commit .env.local — it's already gitignored.

# --- Supabase (required — nothing works without this) ------------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar (optional — bookings save without it) -------------------
# Google Cloud Console -> APIs & Services -> Credentials
# Get the refresh token by running: npm run google-token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Destination for website-created appointments. Copy the Calendar ID from
# Google Calendar > Settings > Integrate calendar (not its display name).
BOOKING_CALENDAR_ID=
# Optional calendars that only block availability; events are never written here.
SCHOOL_CALENDAR_ID=
WORK_CALENDAR_ID=
# PERSONAL_CALENDAR_ID=

# --- Resend / email (optional — bookings save without it) --------------------
# resend.com -> API Keys. Sending permission is enough; no full access needed.
RESEND_API_KEY=
# Leave FROM_EMAIL blank until you own a domain and have verified it in Resend.
# Blank falls back to Resend's sandbox sender, which ONLY delivers to the email
# address that owns your Resend account. Great for testing, useless for clients.
FROM_EMAIL=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BUSINESS_TIMEZONE=America/Chicago
TRAINER_PHONE=

# Required by the protected Vercel reminder cron endpoint. Use a random secret
# of at least 16 characters and set the same value in Vercel.
CRON_SECRET=

# Set to true in Vercel only when you're ready for Google to index the site.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Coming in later layers --------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
